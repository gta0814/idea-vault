{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "removeComments": true,
    "removeEmptyLines": true,
    "showLineNumbers": false,
    "parsableStyle": true
  },
  "include": [
    "AGENTS.md",
    "README.md",
    "ideas/**/*.md"
  ],
  "ignore": {
    "useGitignore": true,
    "customPatterns": [
      "**/*.jpg",
      "**/*.png",
      "**/*.gif",
      "**/*.svg",
      "**/*.mp4",
      "**/interactive/**",
      "repomix-output.xml"
    ]
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
